# SPAZEHAUS — Local environment variables
# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored. Production values live in Vercel → Project → Settings → Environment Variables.

# Supabase — Project Settings → API in the Supabase dashboard
# Use the BASE project URL (no trailing /rest/v1/)
VITE_SUPABASE_URL=https://your-project.supabase.co

# The "anon" public key — safe to embed in client code.
# Security is enforced by RLS policies on the database, not by hiding this key.
# Do NOT put the `service_role` key here — that one bypasses RLS.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# —— Sentry — runtime error tracking ————————————————————————————————————————
# Project Settings → Client Keys (DSN) in the Sentry dashboard.
# When unset, Sentry is OFF (no init, no network calls, no bundle cost beyond
# the import of the no-op shim). Set this in Vercel for production builds.
VITE_SENTRY_DSN=

# Optional. Defaults to "production" / "development" based on the Vite mode.
VITE_SENTRY_ENVIRONMENT=

# Optional. Tagged on every event for source-map correlation. By default
# vite.config.ts injects `spazehaus@<git-short-sha>` (or VERCEL_GIT_COMMIT_SHA
# on Vercel). Only override this if you want a custom release name in the
# Sentry UI — and remember it must match SENTRY_RELEASE below so the runtime
# tag and the uploaded source maps end up under the same release.
VITE_SENTRY_RELEASE=

# —— Sentry — source-map upload (production builds only) ——————————————————
# These three secrets enable the @sentry/vite-plugin to upload sourcemaps so
# production stack traces show real symbols instead of minified names. All
# three must be set together — without any one, sourcemap upload is skipped
# and no .map files are emitted (so they can't leak via dist/).
#
# Personal auth token with `project:releases` scope:
#   https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=

# Org and project slugs from your Sentry URL: https://<org>.sentry.io/projects/<project>/
SENTRY_ORG=
SENTRY_PROJECT=

# Optional. Release name for the upload. Same fallback chain as
# VITE_SENTRY_RELEASE — leave unset to use the git short SHA. If you set this
# explicitly, also set VITE_SENTRY_RELEASE to the same value so the runtime
# and the uploaded maps share a release tag.
SENTRY_RELEASE=

# —— WhatsApp daily-reminder dispatcher ——————————————————————————————————————
# These secrets live in Supabase → Edge Functions → Secrets (NOT in Vercel
# and NOT in .env.local) — the send-daily-reminders Edge Function reads them
# at runtime. They're listed here as documentation only.
#
# Provider choice — defaults to 'stub' (logs only, never sends):
#   stub   = console.log only, useful for testing the dispatch pipeline
#   meta   = Meta WhatsApp Cloud API (free tier 1k convos/month)
#   twilio = Twilio WhatsApp API ($0.005/message after Meta free tier)
# WHATSAPP_PROVIDER=stub

# Meta Cloud API credentials — required when WHATSAPP_PROVIDER=meta:
# WHATSAPP_META_ACCESS_TOKEN=         # System user token, never-expiring
# WHATSAPP_META_PHONE_NUMBER_ID=      # Numeric, from WhatsApp Business Account
# WHATSAPP_META_TEMPLATE_NAME=        # e.g. daily_site_photo_reminder
# WHATSAPP_META_TEMPLATE_LANG=en      # Must match the template registration

# Twilio credentials — required when WHATSAPP_PROVIDER=twilio:
# TWILIO_ACCOUNT_SID=                 # AC...
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=               # whatsapp:+1415XXXXXXX
# TWILIO_WHATSAPP_CONTENT_SID=        # HX... (Twilio Content Template SID)

# Optional — alternative dispatch credential. If set, the cron job can
# Authorization: Bearer this string instead of the service_role key. Lower
# blast radius if the cron config leaks.
# WHATSAPP_DISPATCH_SECRET=

# See supabase/functions/send-daily-reminders/README.md for full setup steps.
